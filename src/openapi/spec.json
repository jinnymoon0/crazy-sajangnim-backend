{
  "openapi": "3.0.3",
  "info": {
    "title": "Crazy Sajangnim Backend",
    "version": "1.0.0",
    "description": "Product collection and catalog service for the Crazy Sajangnim shop. Crawls retailer catalogs, verifies sale prices against the retailer's own data, stores them in Supabase, and serves the catalog to the frontend.\n\nThese endpoints are called server-to-server. The frontend proxies catalog reads so the service token never reaches a browser."
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Local development"
    },
    {
      "url": "https://crazy-sajangnim-backend.vercel.app",
      "description": "Production"
    }
  ],
  "tags": [
    {
      "name": "Catalog",
      "description": "Reading stored products"
    },
    {
      "name": "Collection",
      "description": "Crawling retailers and refreshing the catalog"
    },
    {
      "name": "Brands",
      "description": "Which brands are tracked and collected"
    }
  ],
  "components": {
    "securitySchemes": {
      "serviceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Value of BACKEND_API_TOKEN. Sent as `Authorization: Bearer <token>`. When the variable is unset on the server the check is skipped, which keeps local development simple."
      },
      "cronSecret": {
        "type": "http",
        "scheme": "bearer",
        "description": "Value of CRON_SECRET. Vercel Cron sends this automatically."
      }
    },
    "parameters": {
      "market": {
        "name": "market",
        "in": "query",
        "description": "Storefront region. Defaults to US when omitted or unrecognised.",
        "schema": {
          "type": "string",
          "enum": [
            "US",
            "KR"
          ],
          "default": "US"
        }
      },
      "gender": {
        "name": "gender",
        "in": "query",
        "description": "Segment to read. Unisex products appear in both. Defaults to MEN.",
        "schema": {
          "type": "string",
          "enum": [
            "MEN",
            "WOMEN"
          ],
          "default": "MEN"
        }
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceName": {
            "type": "string",
            "example": "garmentory.com · TONS / Pittsburgh, PA"
          },
          "sourceUrl": {
            "type": "string",
            "format": "uri"
          },
          "market": {
            "type": "string",
            "enum": [
              "US",
              "KR"
            ]
          },
          "currency": {
            "type": "string",
            "enum": [
              "USD",
              "KRW"
            ]
          },
          "gender": {
            "type": "string",
            "enum": [
              "MEN",
              "WOMEN",
              "UNISEX"
            ]
          },
          "brandSlug": {
            "type": "string",
            "example": "auralee"
          },
          "brandName": {
            "type": "string",
            "example": "AURALEE"
          },
          "productName": {
            "type": "string"
          },
          "categorySlug": {
            "type": "string",
            "enum": [
              "outerwear",
              "shirts",
              "knitwear",
              "t-shirts",
              "pants",
              "shorts",
              "bags",
              "shoes",
              "accessories"
            ]
          },
          "imageUrl": {
            "type": "string"
          },
          "originalPrice": {
            "type": "number",
            "nullable": true
          },
          "salePrice": {
            "type": "number"
          },
          "discountPercentage": {
            "type": "integer",
            "nullable": true
          },
          "saleVerification": {
            "type": "string",
            "enum": [
              "VERIFIED",
              "UNVERIFIED"
            ],
            "description": "VERIFIED means the retailer published both the sale and original price for this product. Only verified products are shown on the site."
          },
          "isAvailable": {
            "type": "boolean"
          },
          "collectedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CatalogPage": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "total": {
            "type": "integer",
            "description": "Matching products across all pages."
          },
          "hasMore": {
            "type": "boolean"
          },
          "market": {
            "type": "string",
            "enum": [
              "US",
              "KR"
            ]
          },
          "gender": {
            "type": "string",
            "enum": [
              "MEN",
              "WOMEN"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CollectionResult": {
        "type": "object",
        "properties": {
          "products": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Product"
            }
          },
          "count": {
            "type": "integer"
          },
          "market": {
            "type": "string",
            "enum": [
              "US",
              "KR"
            ]
          },
          "gender": {
            "type": "string",
            "enum": [
              "MEN",
              "WOMEN"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "diagnostics": {
            "type": "object",
            "description": "Only present when debug=true. Reports per-brand result counts and why candidates were rejected.",
            "additionalProperties": true
          }
        }
      },
      "RefreshResult": {
        "type": "object",
        "properties": {
          "market": {
            "type": "string",
            "enum": [
              "US",
              "KR"
            ]
          },
          "gender": {
            "type": "string",
            "enum": [
              "MEN",
              "WOMEN"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "status": {
            "type": "integer"
          },
          "count": {
            "type": "integer"
          },
          "savedCount": {
            "type": "integer"
          },
          "error": {
            "type": "string"
          }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "Brand": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "example": "stone-island"
          },
          "englishName": {
            "type": "string",
            "example": "STONE ISLAND"
          },
          "koreanName": {
            "type": "string",
            "nullable": true,
            "example": "스톤아일랜드"
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Every spelling matched when identifying this brand in a listing."
          },
          "isActive": {
            "type": "boolean"
          },
          "addedBy": {
            "type": "string",
            "nullable": true,
            "description": "Admin email, or \"seed\" for brands shipped with the code."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "store": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BrandStore"
              }
            ],
            "nullable": true,
            "description": "The brand's own shop, when one was found."
          }
        }
      },
      "BrandCandidate": {
        "type": "object",
        "description": "A possible English name for a brand written in another language.",
        "properties": {
          "englishName": {
            "type": "string",
            "example": "STONE ISLAND"
          },
          "slug": {
            "type": "string",
            "example": "stone-island"
          },
          "koreanName": {
            "type": "string",
            "nullable": true
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "integer",
            "description": "Higher means the name appeared earlier and more often in search results."
          },
          "sourceUrl": {
            "type": "string",
            "nullable": true
          },
          "sourceTitle": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "BrandStore": {
        "type": "object",
        "description": "A shop the brand runs itself, found automatically when the brand is added. Small labels are rarely discounted by the big retailers, so this is often the only place their sales appear.",
        "properties": {
          "domain": {
            "type": "string",
            "example": "nuuanu.kr"
          },
          "platform": {
            "type": "string",
            "enum": [
              "cafe24",
              "shopify"
            ]
          },
          "market": {
            "type": "string",
            "enum": [
              "US",
              "KR"
            ],
            "description": "Which storefront the shop's prices belong to, decided by the currency it charges in."
          }
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing or incorrect bearer token.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "serviceToken": []
    }
  ],
  "paths": {
    "/api/catalog/products": {
      "get": {
        "tags": [
          "Catalog"
        ],
        "summary": "Read the product catalog",
        "description": "Returns a page of stored products, newest catalog refresh first. Only available, price-verified products are returned. Unisex products appear under both genders.",
        "parameters": [
          {
            "$ref": "#/components/parameters/market"
          },
          {
            "$ref": "#/components/parameters/gender"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "Products per page. Values above 300 are clamped.",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300,
              "default": 60
            }
          },
          {
            "name": "sort",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "discount-desc",
                "price-asc",
                "price-desc",
                "newest"
              ],
              "default": "discount-desc"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "description": "Brand slug. Repeat the parameter to filter on several brands.",
            "style": "form",
            "explode": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "adidas",
                  "aime-leon-dore",
                  "auralee",
                  "bape",
                  "beams-plus",
                  "beheavyer",
                  "belier",
                  "comoli",
                  "comme-des-garcons",
                  "danton",
                  "hatchingroom",
                  "hibiscus",
                  "kamiya",
                  "kapital",
                  "kleesier",
                  "lemaire",
                  "needles",
                  "nike",
                  "nuuanu",
                  "ourselves",
                  "pakua",
                  "polyteru",
                  "puma",
                  "recto",
                  "tony-wack"
                ]
              }
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Category slug. \"all\" is treated as no filter.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "outerwear",
                "shirts",
                "knitwear",
                "t-shirts",
                "pants",
                "shorts",
                "bags",
                "shoes",
                "accessories"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of catalog products.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogPage"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "The catalog could not be read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/products": {
      "get": {
        "tags": [
          "Collection"
        ],
        "summary": "Run a collection pass",
        "description": "Crawls retailers for one market and gender, saves everything it verifies, and returns the products visible to that segment.\n\nThis is expensive and can run for minutes. `mode=direct` crawls retailer catalogs only and skips search-engine discovery, which is much faster and is what the nightly refresh uses.",
        "parameters": [
          {
            "$ref": "#/components/parameters/market"
          },
          {
            "$ref": "#/components/parameters/gender"
          },
          {
            "name": "mode",
            "in": "query",
            "description": "Set to `direct` to skip search-engine discovery.",
            "schema": {
              "type": "string",
              "enum": [
                "direct"
              ]
            }
          },
          {
            "name": "debug",
            "in": "query",
            "description": "Include per-brand diagnostics in the response.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Products collected and saved.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CollectionResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "Search discovery is not configured (SEARXNG_URL missing).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Every brand search failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/cron/refresh-products": {
      "get": {
        "tags": [
          "Collection"
        ],
        "summary": "Nightly catalog refresh",
        "description": "Triggers a collection pass for one market and gender. Scheduled by Vercel Cron; see vercel.json for the times.",
        "security": [
          {
            "cronSecret": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/market"
          },
          {
            "$ref": "#/components/parameters/gender"
          }
        ],
        "responses": {
          "200": {
            "description": "Refresh finished.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResult"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "description": "The refresh could not be completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RefreshResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/brands": {
      "get": {
        "tags": [
          "Brands"
        ],
        "summary": "List tracked brands",
        "description": "Every brand collection searches for. Falls back to the list shipped with the code when the brands table is missing or empty.",
        "parameters": [
          {
            "name": "includeInactive",
            "in": "query",
            "description": "Include brands that have been switched off.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Tracked brands.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "brands": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Brand"
                      }
                    },
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "Brands"
        ],
        "summary": "Track a new brand",
        "description": "Track a brand across both storefronts. The brand's own online shop is looked for at the same time and remembered, so its sale items can be read straight from the source. Callers should collect the brand afterwards with POST /api/brands/{slug}/collect and drop it again if nothing comes back — a brand with no sale items has nothing to show in the shop.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "englishName"
                ],
                "properties": {
                  "englishName": {
                    "type": "string",
                    "example": "Stone Island"
                  },
                  "koreanName": {
                    "type": "string",
                    "nullable": true,
                    "example": "스톤아일랜드"
                  },
                  "aliases": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Extra spellings to match. The English and Korean names are added automatically."
                  },
                  "slug": {
                    "type": "string",
                    "description": "Derived from the English name when omitted.",
                    "pattern": "^[a-z0-9-]{2,60}$"
                  },
                  "addedBy": {
                    "type": "string",
                    "description": "Admin email, recorded for reference."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The brand is now tracked, with its own shop attached when one was found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "brand": {
                      "$ref": "#/components/schemas/Brand"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The name is missing, or is not written in Latin script.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "409": {
            "description": "Already tracked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "The brands table has not been created yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/brands/search": {
      "get": {
        "tags": [
          "Brands"
        ],
        "summary": "Find a brand's English name",
        "description": "Searches the web for a brand written in any language and returns the English names retailers sell it under, best guess first. Nothing is saved; post the chosen candidate to /api/brands.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Brand name in any language.",
            "schema": {
              "type": "string",
              "example": "스톤아일랜드"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Candidate brand names.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "query": {
                      "type": "string"
                    },
                    "alreadyLatin": {
                      "type": "boolean",
                      "description": "True when the query was already written in Latin script and could be added directly."
                    },
                    "candidates": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/BrandCandidate"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "No query given.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "502": {
            "description": "The search could not be completed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/brands/{slug}": {
      "delete": {
        "tags": [
          "Brands"
        ],
        "summary": "Stop tracking a brand",
        "description": "Future collection passes skip the brand. Products already collected keep their brand label and stay in the catalog.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "stone-island"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "No longer tracked.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "removed": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "That brand is not tracked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/brands/{slug}/collect": {
      "post": {
        "tags": [
          "Brands"
        ],
        "summary": "Collect one brand's sale items now",
        "description": "Collect a brand's sale items from every source right away, rather than waiting for the nightly refresh. A brand with no shop on file has one looked for and saved first. `collected` is the number of sale items found per storefront; zero in both means the brand has nothing on sale anywhere we search.",
        "parameters": [
          {
            "name": "slug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "c-p-company"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Collection finished.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "slug": {
                      "type": "string"
                    },
                    "englishName": {
                      "type": "string"
                    },
                    "collected": {
                      "type": "object",
                      "description": "Items found per market.",
                      "properties": {
                        "US": {
                          "type": "integer"
                        },
                        "KR": {
                          "type": "integer"
                        }
                      }
                    },
                    "saved": {
                      "type": "integer"
                    }
                  }
                },
                "example": {
                  "slug": "c-p-company",
                  "englishName": "C.P. COMPANY",
                  "collected": {
                    "US": 8,
                    "KR": 10
                  },
                  "saved": 18
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "That brand is not tracked.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "The collection run failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  }
}
